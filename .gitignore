# ⚠️ gitignore 不支援「尾隨註解」——# 只有在行首才是註解,
#    寫成 `runs/   # 說明` 會讓整串變成 pattern 而完全失效。註解一律獨立成行。

# 訓練產出
lightning_logs/
job_logs/
# RUNDIR=runs/<實驗名> 的各實驗輸出
runs/
# 手動封存的舊 version_* 目錄
_archive/
*.ckpt
wandb/

# 分析:原始 TensorBoard event 檔動輒 80 MB+(GitHub 上限 100 MB),
# 只保留 tools/events_to_csv.py 萃取出的 CSV、notebook 與報告。
analysis/events.out.tfevents.*
# 統計檔的檢查用副本;正本在 utils/
analysis/*.nc

# 模型權重(太大,另行取得)
*.onnx
onnx/*.onnx

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# 暫存
*.tmp
.DS_Store

# 逐層梯度原始 CSV 46 MB;版控的是 step<=45000 的 gzip 版
analysis/run_mine_per_layer.csv

# 叢集 job log(scp 下來檢查用,非分析產物)
analysis/job-*.out
analysis/job-*.err

# Build outputs from analysis/*.md — regenerate rather than track. The PDF alone
# is 3.7 MB and changes wholesale on every export, so it dominates the history of
# a repository whose text is a few hundred KB.
analysis/*.pdf
analysis/*.html

# Diagnostic figures from forecast runs. A whole-season sweep is ~30 storms x a
# few initial times x five plots, and they are reproducible from the .npy in one
# command. Training-analysis figures under analysis/figures/training/ ARE tracked:
# those come from runs that will not happen again.
analysis/figures/forecasts/
